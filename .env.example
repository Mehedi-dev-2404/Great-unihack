# ElevenLabs API key (voice agent + MCP), from elevenlabs.io > Settings > API Keys
ELEVENLABS_API_KEY=
# Anthropic API key (Claude reasoning + tools), from console.anthropic.com
ANTHROPIC_API_KEY=
# Base URL of the FastAPI backend the frontend/voice agent calls
API_BASE_URL=http://localhost:8000
# Optional: override the Claude model id used by the backend
FOLA_MODEL=
